# Environment Configuration for Restaurant Management Service
# Copy this file to .env and update with your values

# ============================================================
# Database Configuration - Choose ONE method below
# ============================================================

# Method 1: DATABASE_URL (Recommended for Vertigo)
# Format: mysql://username:password@host:port/database_name
DATABASE_URL=mysql://root:password@localhost:3306/restaurant_db

# Method 2: Individual Database Variables (Alternative)
# Uncomment below if you prefer separate env variables
# DB_HOST=localhost
# DB_USER=root
# DB_PASSWORD=password
# DB_NAME=restaurant_db
# DB_PORT=3306

# ============================================================
# Node Environment
# ============================================================
NODE_ENV=development
# NODE_ENV=production

# ============================================================
# Server Configuration
# ============================================================
PORT=3000
# API_BASE_URL=http://localhost:3000

# ============================================================
# JWT Configuration (Authentication)
# ============================================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# ============================================================
# CORS Configuration
# ============================================================
CORS_ORIGIN=http://localhost:3001
# For production, specify exact domain
# CORS_ORIGIN=https://yourdomain.com

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=debug
# LOG_LEVEL=info
# LOG_LEVEL=error

# ============================================================
# API External Services (Optional)
# ============================================================
# THEMEALDB_API_URL=https://www.themealdb.com/api/json/v1/1
